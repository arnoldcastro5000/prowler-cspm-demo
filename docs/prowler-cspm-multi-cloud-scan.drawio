        <mxCell id="svc-group-ingest" style="fillColor=#FCE4EC;strokeColor=#E7157B;rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;fontStyle=1;fontSize=12;fontColor=#E7157B;fontFamily=Helvetica;container=1;collapsible=0;pointerEvents=0;shadow=1;strokeWidth=1.5;" value="Ingest" vertex="1" parent="1">
