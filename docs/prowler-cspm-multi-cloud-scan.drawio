        <mxCell id="edge-prowler-ingest" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;entryX=0;entryY=0.5;strokeWidth=1.5;fontFamily=Helvetica;" edge="1" parent="1" source="svc-group-prowler" target="svc-group-ingest">
